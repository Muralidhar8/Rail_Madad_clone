# Server Port
PORT=5000

# Option 1: Single Connection URI (Provided by TiDB, Railway, Render, etc.)
# DATABASE_URL=mysql://username:password@host:port/database_name

# Option 2: Individual Connection Parameters
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rail_madad
DB_USER=root
DB_PASSWORD=root
DB_SSL=false

# Optional: Gemini API Key for AI Chatbot Assistant
GEMINI_API_KEY=your_gemini_api_key_here
